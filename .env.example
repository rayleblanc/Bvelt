GEOAPIFY_API_KEY=

# 2. LocationIQ API (Primary Geocoding / Secondary Nearby POI Search) - 5,000 req/day (150,000/mo renewable)
LOCATIONIQ_API_KEY=

# 3. OpenCage Data API (Secondary Geocoding & Address Parsing) - 2,500 req/day (75,000/mo renewable)
OPENCAGE_API_KEY=

# 4. OpenRouteService API (Primary Drive-Time Isochrones & Contractor Service Area) - 2,000-8,000 req/day renewable
OPENROUTESERVICE_API_KEY=

# 5. Tavily AI Search (Primary Web Search & Business Reputation Audit) - 1,000 credits/month renewable
TAVILY_API_KEY=

