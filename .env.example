# GEMINI_API_KEY: Clave de API para las funciones generativas y análisis automatizados. 
# Obtén tu clave en https://aistudio.google.com/app/apikey
# Para que funcione en la app lanzada, VE A LA PESTAÑA 'SECRETS' EN EL MENÚ DE CONFIGURACIÓN
# Y AÑADE 'GEMINI_API_KEY' CON EL VALOR QUE TIENES.
GEMINI_API_KEY=
GROQ_API_KEY=

# You.com (Paid API): FINITE_ONE_TIME (No usar en fallback automático). Plan MCP gratuito: RENEWABLE_DAILY (Candidato a fallback).
YDC_API_KEY=

# APP_URL: La URL base de la aplicación (producción: https://bvelt.app)
APP_URL=https://bvelt.app

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PROD_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROD_PRICE_MONTHLY=
STRIPE_PROD_PRICE_ANNUAL=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_YEARLY=
VITE_STRIPE_PROD_PRICE_MONTHLY=
VITE_STRIPE_PROD_PRICE_YEARLY=

# Firebase Admin SDK Configuration (Production Persistence)
# To enable persistent Firestore Admin counters and bypass in-memory degraded mode,
# provide service account credentials for project "localflowpro-20e3d" (matching client app).
# Option A: Stringified service account JSON in one of these env vars:
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_ADMIN_CREDENTIALS=
# Option B: Path to service-account.json on disk:
GOOGLE_APPLICATION_CREDENTIALS=

# Resend Email Service Configuration (REQUIRED - El sistema falla explícitamente si se intenta usar sin la variable)
# Obtén tu clave en https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bvelt <onboarding@resend.dev>

# RESILIENT GEO & SEARCH PROVIDER MATRIX (1st to 1,000th client ready)
