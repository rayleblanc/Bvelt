{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bvelt",
  "main": "./worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
